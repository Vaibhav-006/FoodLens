{
  "name": "foodlens",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "dev:web": "turbo run dev --filter=web",
    "dev:backend": "turbo run dev --filter=backend",
    "dev:mobile": "turbo run dev --filter=mobile",
    "test:pipeline": "npm --workspace=backend run test:pipeline"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.1",
    "prettier": "^3.4.2"
  },
  "packageManager": "npm@11.1.0",
  "engines": {
    "node": ">=18.0.0"
  }
}

